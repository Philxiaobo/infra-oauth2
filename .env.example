INFRA_OAUTH2_ISSUER=http://localhost:9000

# Optional local-only overrides for Spring relaxed binding.
# Replace these before any non-local environment uses seed clients or users.
INFRA_OAUTH2_CLIENTS_1_CLIENT_SECRET={bcrypt}<replace-with-bcrypt-hash>
INFRA_OAUTH2_USERS_0_PASSWORD={bcrypt}<replace-with-bcrypt-hash>
